# Optional. Copy to .env only if you want to override defaults. .env is gitignored.
#
# Auth is via gcloud Application Default Credentials (ADC) — there are NO API keys:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project som-nero-phi-jonc101-secure
#   (+ Stanford full-traffic VPN on)
#
# Overrides (defaults shown; leave unset to use them):

# Vertex AI project where the LLMs are enabled (each user authenticates via their own ADC):
VERTEX_PROJECT=som-nero-phi-jonc101-secure

# BigQuery billing/quota project for Stage 1 (data mapping):
GOOGLE_CLOUD_PROJECT=som-nero-phi-jonc101

# Vertex request labels for billing attribution (attached to every LLM call).
# SET user_id so your spend is attributable — it defaults to the placeholder "your_name".
# VERTEX_LABEL_USER=your_name
# VERTEX_LABEL_EXPERIMENT=uti-phenotyping
